{
  "name": "tgm-alarm-center-native",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts && node scripts/verify-web-core.mjs && node scripts/verify-pricing.mjs",
    "verify:javascript": "node scripts/verify-javascript.mjs",
    "verify:whitespace": "node scripts/verify-whitespace.mjs",
    "build:web": "node scripts/build-web.mjs",
    "package:web": "node scripts/package-web.mjs",
    "verify:packaging": "node scripts/verify-packaging.mjs",
    "serve:web": "node scripts/serve-web.mjs",
    "browser:smoke": "npx --yes playwright@1.55.0 install chromium && npx --yes -p playwright@1.55.0 node scripts/browser-smoke.mjs",
    "verify:store-config": "node scripts/verify-store-config.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:full-release": "node scripts/verify-full-release.mjs",
    "build:android:aab": "node scripts/build-store.mjs android",
    "build:ios:ipa": "node scripts/build-store.mjs ios",
    "build:team:android": "node scripts/build-team.mjs android",
    "build:team:ios": "node scripts/build-team.mjs ios",
    "verify:migrations": "bash scripts/migration-gates.sh status && bash scripts/migration-gates.sh preflight"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.2",
    "expo": "~53.0.20",
    "expo-application": "~6.1.5",
    "expo-build-properties": "~0.14.8",
    "expo-constants": "~17.1.7",
    "expo-device": "~7.1.4",
    "expo-document-picker": "~13.1.1",
    "expo-file-system": "~18.1.10",
    "expo-iap": "^3.4.13",
    "expo-linking": "~7.1.7",
    "expo-notifications": "~0.31.4",
    "expo-sharing": "~13.1.5",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "react": "19.0.0",
    "react-native": "0.79.6"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "~19.0.10",
    "eslint": "^9.35.0",
    "jest": "^29.7.0",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "expo-iap"
      ]
    }
  }
}
