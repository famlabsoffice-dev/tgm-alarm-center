{
  "expo": {
    "name": "TGM ALARM CENTER",
    "slug": "tgm-alarm-center",
    "version": "1.0.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "scheme": "tgm-alarm-center",
    "icon": "./icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tgm.alarmcenter",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "TGM ALARM CENTER benötigt Benachrichtigungen, damit deine Alarmzeiten zuverlässig angekündigt werden."
      }
    },
    "android": {
      "package": "com.tgm.alarmcenter",
      "edgeToEdgeEnabled": false,
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./icon.png",
        "backgroundColor": "#090C12"
      }
    },
    "plugins": [
      "./plugins/withKotlinStdlibResolution",
      "expo-iap",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/notifications/alarm_pulse.wav",
            "./assets/notifications/alarm_siren.wav",
            "./assets/notifications/alarm_chime.wav"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "kotlinVersion": "2.0.21"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "868fbe6b-d41a-4435-8cd1-0cd9c27c936a"
      }
    }
  }
}
